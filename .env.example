# Hostname the app is served from (the DNS name pointed at Traefik). Passkeys are bound to it —
# changing it later invalidates existing passkeys.
RP_ID=gym.example.com
ORIGIN=https://gym.example.com
RP_NAME=openGym

# Optional: comma-separated user ids (see db.json in the data volume) that get the admin dashboard,
# and invite-only signups.
#ADMIN_UIDS=
#INVITE_ONLY=1
